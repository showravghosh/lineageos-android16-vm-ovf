# VMware Workstation / Workstation Pro guest support.
#
# The virtio_x86_64 target is built for QEMU, where every device is virtio.
# VMware offers no virtio devices at all, so without these the VM boots a
# kernel with no display, no network, no sound and no mouse - which is exactly
# what was happening: SATA worked (ATA_PIIX/SATA_AHCI were already on, so the
# disks appeared) and nothing else did.
#
# All built in (=y), not modules: the ramdisk has no module loading set up for
# these, and the display driver in particular is needed before /vendor mounts.

# Display - VMware SVGA II. vmwgfx provides KMS + dumb buffers, which is all
# the DRM composer needs; 3D is off in the .vmx, so rendering stays on the
# software Vulkan path (vulkan.lvp_mesa3d) already in the image.
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_TTM=y
CONFIG_DRM_TTM_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
# Last-resort framebuffer if vmwgfx ever fails to bind, so the screen is never
# simply black and the boot is still diagnosable.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y

# Network - the .vmx uses e1000e. vmxnet3 is included too so the OVF can be
# imported onto ESXi/Player profiles that default to it. No network means no
# Play Store, so both are built in.
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_VMXNET3=y

# Sound - the .vmx uses es1371. The QEMU side uses ens1370/AC97, and only
# ENS1370 was enabled, so VMware had a sound card with no driver.
CONFIG_SND_PCI=y
CONFIG_SND_ENS1371=y

# Input.
#
# CONFIG_MOUSE_PS2_VMMOUSE is deliberately NOT enabled. It binds to the VMware
# backdoor port - which QEMU also emulates - and once bound it becomes the
# ACTIVE pointer, displacing the device that actually works. Enabling it broke
# the cursor in BOTH hypervisors at once, which is how it was found:
#
#   $ (qemu) info mice
#     Mouse #2: QEMU PS/2 Mouse
#     Mouse #3: QEMU Virtio Tablet (absolute)
#   * Mouse #7: vmmouse (absolute)        <- hijacked the pointer
#
# Without it, QEMU uses the virtio tablet and VMware uses the virtual USB HID
# mouse (mouse.vusb.enable in the .vmx) - both absolute, both working.
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# VMware platform integration
CONFIG_VMWARE_VMCI=y
CONFIG_VMWARE_BALLOON=y
CONFIG_VMWARE_PVSCSI=y
